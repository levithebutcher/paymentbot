# ==========================================
# Telegram Payment Bot Configuration
# ==========================================

# Your Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz_123456

# Private Admin Group or Channel ID where payment verification cards will be sent.
# Supergroups typically start with -100 (e.g. -1001234567890).
# Add your bot as Admin in this group with 'Post Messages' permission.
ADMIN_GROUP_ID=-1001234567890

# Optional comma-separated Admin User IDs who can use /admin commands directly
ADMIN_IDS=123456789,987654321

# Your UPI ID (shown to users for easy copy-paste)
UPI_ID=yourname@upi

# Payee Name shown on payment screen
UPI_NAME=My Store

# Path to your static UPI QR code image file
QR_IMAGE_PATH=assets/qr_code.png

# Path to the SQLite database file
DB_PATH=payment_bot.db
